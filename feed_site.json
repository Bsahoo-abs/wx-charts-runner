<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AbsoluteMet Models</title>
<meta name="description" content="Forecast charts, videos and cyclone-ensemble tracks from ECMWF, AIFS, GFS, AIGFS, ICON and GEM for India and the north Indian Ocean, updated automatically.">
<link rel="icon" type="image/png" href="favicon.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="theme-color" content="#0F2C3F">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<script>try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
<style>
:root {
  --ink: #0F2C3F; --lagoon: #174559; --mist: #E7EEF0; --paper: #F6F9FA; --turmeric: #F2A900; --teal: #2FB3A6;
  --alert: #D64545; --text: #12303F; --soft: #557080; --line: #C9D7DD; --stage: #FFFFFF; --chip: #DDE8EC;
  --bg: var(--mist); --surface: var(--paper); --sel: var(--ink);
  --dock-h: 104px; --r-s: 6px; --r-m: 12px;
  --sans: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
  --cond: "Barlow Condensed", "Barlow", system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0B2231; --surface: #10303F; --text: #E4EEF2; --soft: #8FAAB7; --line: #24495A; --stage: #F4F7F8;
    --chip: #17414F; --sel: #1F5D74;
  }
}
:root[data-theme="dark"] {
  --bg: #0B2231; --surface: #10303F; --text: #E4EEF2; --soft: #8FAAB7; --line: #24495A; --stage: #F4F7F8; --chip: #17414F; --sel: #1F5D74;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { margin: 0; }
body { background: var(--bg); color: var(--text); font: 16px/1.45 var(--sans); -webkit-font-smoothing: antialiased; }
button, select { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--turmeric); outline-offset: 2px; border-radius: 4px; }

/* ---------- top bar ---------- */
.top { background: var(--ink); color: #fff; }
.top-in { max-width: 1320px; margin: 0 auto; padding: 10px 20px; display: flex; align-items: center; gap: 18px; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; }
.brand .logo { width: 40px; height: auto; flex: none; }
.brand .wordmark { height: 38px; width: auto; flex: none; display: block; }
.brand b { font: 700 21px/1 var(--cond); letter-spacing: .3px; }
.brand span { font: 500 13px/1.25 var(--sans); color: #9FC0CF; display: block; max-width: 190px; }
.modes { display: flex; background: rgba(255,255,255,.08); border-radius: 999px; padding: 3px; margin-left: 12px; }
.modes button { background: none; border: 0; color: #CFE1E8; padding: 6px 14px; border-radius: 999px; cursor: pointer;
  font-weight: 600; font-size: 15px; }
.modes a { color: #CFE1E8; padding: 6px 14px; border-radius: 999px; font-weight: 600; font-size: 15px; text-decoration: none; }
.modes a:hover { background: rgba(255,255,255,.1); }
.modes button[aria-pressed="true"] { background: var(--turmeric); color: var(--ink); }
.fresh { margin-left: auto; color: #9FC0CF; font-size: 13px; text-align: right; }
.short { display: none; }

/* ---------- layout ---------- */
.wrap { max-width: 1320px; margin: 0 auto; padding: 18px 20px 30px; display: grid;
  grid-template-columns: 250px minmax(0, 1fr); gap: 22px; }
.rail { align-self: start; position: sticky; top: 14px; display: flex; flex-direction: column; gap: 18px; }
.rail h2 { font: 600 14px/1.2 var(--sans); color: var(--soft); margin: 0 0 6px 2px; }
.list { display: flex; flex-direction: column; gap: 2px; }
.item { display: flex; align-items: baseline; gap: 8px; width: 100%; text-align: left; background: none; border: 0;
  padding: 7px 10px; border-radius: var(--r-s); cursor: pointer; }
.item:hover:not(:disabled) { background: var(--chip); }
a.item { text-decoration: none; color: inherit; box-sizing: border-box; }
.item[aria-pressed="true"] { background: var(--sel); color: #fff; box-shadow: inset 3px 0 0 var(--turmeric); }
.item[aria-pressed="true"] .meta { color: #A9C6D3; }
.item:disabled { opacity: .38; cursor: default; }
.item .name { font-weight: 600; }
.item { flex-wrap: wrap; }
.item .next { flex-basis: 100%; padding-left: 16px; font: 500 12px/1.2 var(--cond); color: var(--soft); }
.item .meta { margin-left: auto; font: 500 13px/1 var(--cond); color: var(--soft); white-space: nowrap; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); flex: none; align-self: center; }
.live { display: inline-block; font: 600 11px/1 var(--sans); color: var(--ink); background: var(--turmeric);
  padding: 2px 5px; border-radius: 999px; margin-left: 4px; }
.dot.warn { background: var(--turmeric); } .dot.old { background: var(--alert); }
.group + .group { margin-top: 10px; }
.group-name { font-size: 13px; color: var(--soft); margin: 0 0 2px 10px; }

/* ---------- stage ---------- */
.main { min-width: 0; }
.head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 10px; }
.head h1 { font: 700 26px/1.1 var(--cond); margin: 0; letter-spacing: .2px; margin-right: auto; }
.head h1 small { display: block; font: 500 15px/1.3 var(--sans); color: var(--soft); margin-top: 3px; letter-spacing: 0; }
.tools { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.tool { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-s); padding: 6px 11px;
  font-size: 14px; font-weight: 600; text-decoration: none; color: var(--text); cursor: pointer; }
.tool:hover { border-color: var(--lagoon); }
.stage { background: var(--stage); border-radius: var(--r-m); overflow: hidden; display: flex; justify-content: center;
  align-items: center; min-height: 240px; }
.stage img { display: block; width: 100%; height: auto; }
.stage video { display: block; width: auto; height: auto; max-width: 100%; max-height: 80vh; background: #000; }
.stage .msg { padding: 48px 24px; color: #557080; text-align: center; max-width: 52ch; }
.note { color: var(--soft); font-size: 14px; margin: 10px 2px 0; max-width: 80ch; }
.extra { margin-top: 18px; }
.extra h3 { font: 600 17px/1.2 var(--sans); margin: 0 0 8px; }
.extra .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
.extra figure { margin: 0; background: var(--stage); border-radius: var(--r-m); overflow: hidden; }
.extra figure img { width: 100%; display: block; }
.extra figcaption { font-size: 14px; padding: 8px 12px; color: #2c4a59; background: var(--stage); }

/* ---------- forecast tape (the time control) ---------- */
.dock { position: static; z-index: 5; box-shadow: 0 6px 24px rgba(9,26,36,.18);
  margin-top: 12px; background: var(--ink); color: #fff; border-radius: var(--r-m); padding: 10px 14px 12px;
  display: grid; grid-template-columns: auto 1fr auto; gap: 6px 14px; align-items: center; }
.btns { display: flex; gap: 4px; }
.btns button { width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.1); color: #fff;
  cursor: pointer; display: grid; place-items: center; }
.btns button:hover { background: rgba(255,255,255,.18); }
.btns button.play { background: var(--turmeric); color: var(--ink); }
.btns svg { width: 18px; height: 18px; }
.when { font: 600 18px/1.1 var(--cond); text-align: right; white-space: nowrap; }
.when small { display: block; font: 500 13px/1.2 var(--sans); color: #9FC0CF; }
.tape { position: relative; height: 46px; }
.tape .days { position: absolute; inset: 0 0 auto 0; height: 18px; font: 600 13px/18px var(--cond); color: #BBD3DD; }
.tape .days span { position: absolute; transform: translateX(-1px); padding-left: 4px; border-left: 1px solid rgba(255,255,255,.35);
  white-space: nowrap; }
.tape .ticks { position: absolute; left: 0; right: 0; top: 24px; height: 10px; }
.tape .ticks i { position: absolute; width: 1px; height: 6px; background: rgba(255,255,255,.35); top: 2px; }
.tape .ticks i.major { height: 10px; top: 0; background: rgba(255,255,255,.7); }
.tape input { position: absolute; left: 0; right: 0; top: 16px; width: 100%; height: 30px; margin: 0; background: none;
  -webkit-appearance: none; appearance: none; cursor: pointer; }
.tape input::-webkit-slider-runnable-track { height: 30px; background: none; }
.tape input::-moz-range-track { height: 30px; background: none; }
.tape input::-webkit-slider-thumb { -webkit-appearance: none; width: 4px; height: 30px; border-radius: 2px; background: var(--turmeric);
  box-shadow: 0 0 0 4px rgba(242,169,0,.25); }
.tape input::-moz-range-thumb { width: 4px; height: 30px; border: 0; border-radius: 2px; background: var(--turmeric);
  box-shadow: 0 0 0 4px rgba(242,169,0,.25); }
.tape .done { position: absolute; left: 0; top: 34px; height: 3px; background: var(--turmeric); border-radius: 2px; }
.tape .rule { position: absolute; left: 0; right: 0; top: 34px; height: 3px; background: rgba(255,255,255,.15); border-radius: 2px; }

/* ---------- phone ---------- */
.pickers { display: none; }
.sheet-bg { position: fixed; inset: 0; background: rgba(9,26,36,.55); z-index: 40; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 41; background: var(--surface); color: var(--text);
  border-radius: 18px 18px 0 0; max-height: 78vh; overflow: auto; padding: 8px 16px calc(18px + env(safe-area-inset-bottom)); }
.sheet .grab { width: 44px; height: 5px; border-radius: 3px; background: var(--line); margin: 4px auto 12px; }
.sheet h2 { font: 700 20px/1.2 var(--cond); margin: 0 0 10px; }
.tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 14px; }
.tile { text-align: left; border: 1px solid var(--line); background: var(--bg); border-radius: var(--r-s); padding: 10px 12px;
  cursor: pointer; font-weight: 600; min-height: 48px; }
.tile small { display: block; font: 500 13px/1.25 var(--sans); color: var(--soft); margin-top: 2px; }
.tile[aria-pressed="true"] { background: var(--sel); border-color: var(--turmeric); color: #fff; }
.tile[aria-pressed="true"] small { color: #A9C6D3; }
.tile:disabled { opacity: .38; }
.sheet .group-name { margin: 2px 0 6px; font-size: 14px; }

@media (max-width: 860px) {
  .top-in { padding: 8px 12px 10px; gap: 8px 10px; flex-wrap: wrap; }
  .brand span, .fresh, .long { display: none; }
  .short { display: inline; }
  .brand { min-width: 0; flex: 1; }
  .brand b { font-size: 19px; white-space: nowrap; display: block; }
  .brand .logo { width: 34px; }
  .theme { order: 2; }
  .modes { order: 3; width: 100%; margin-left: 0; justify-content: space-between; }
  .modes button, .modes a { flex: 1; text-align: center; }
  .modes button, .modes a { padding: 6px 4px; font-size: 13.5px; min-width: 0; }
  .modes { flex-wrap: wrap; gap: 2px; }
  .dock, .tape { max-width: 100vw; }
  .tape { overflow: hidden; }
  .wrap { display: block; padding: 10px 12px calc(var(--dock-h) + 24px + env(safe-area-inset-bottom)); }
  .rail { display: none; }
  .pickers { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px; }
  .picker { display: flex; align-items: center; justify-content: space-between; gap: 6px; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--r-s); padding: 9px 12px; cursor: pointer; text-align: left; min-width: 0; }
  .picker span { display: block; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .picker small { display: block; font: 500 12px/1.2 var(--sans); color: var(--soft); }
  .picker svg { flex: none; width: 14px; height: 14px; color: var(--soft); }
  .head h1 { font-size: 18px; }
  .head h1 small { font-size: 13px; }
  .stage { border-radius: var(--r-s); margin: 0 -4px; }
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; border-radius: 16px 16px 0 0; margin: 0; box-shadow: none;
    padding: 10px 14px calc(12px + env(safe-area-inset-bottom)); grid-template-columns: auto 1fr; }
  .dock .tape { grid-column: 1 / -1; grid-row: 2; }
  .btns button { width: 44px; height: 44px; }
}

.theme { flex: none; width: 34px; height: 34px; border-radius: 50%; border: 0; background: rgba(255,255,255,.1); color: #E7EEF0;
  cursor: pointer; display: grid; place-items: center; }
.theme:hover { background: rgba(255,255,255,.2); }
.theme svg { width: 17px; height: 17px; }
</style>
</head>
<body>
<header class="top">
  <div class="top-in">
    <a class="brand" href="#" aria-label="AbsoluteMet models">
      <img class="wordmark" src="logo-am-wide.png" alt="AbsoluteMet" width="152" height="38">
      <div><span>Model charts for India and the north Indian Ocean</span></div>
    </a>
    <div class="modes" role="group" aria-label="View">
      <button id="tab-models" aria-pressed="true">Charts</button>
      <button id="tab-ens" aria-pressed="false">Cyclones</button>
      <a href="lab.html#sat"><span class="long">Satellite</span><span class="short">Sat</span></a>
      <a href="lab.html#radar">Radar</a>
      <a href="livemap.html"><span class="long">Live map</span><span class="short">Live</span></a>
      <a href="route.html"><span class="long">Route weather</span><span class="short">Route</span></a>
      <a href="live3d.html"><span class="long">3D view</span><span class="short">3D</span></a>
    </div>
    <div class="fresh" id="built">Loading…</div>
    <button class="theme" id="theme" aria-label="Switch between light and dark" title="Light / dark"></button>
  </div>
</header>

<div class="wrap">
  <aside class="rail" aria-label="Choose">
    <section><h2>Model</h2><div class="list" id="rail-models"></div></section>
    <section><h2 id="rail-charts-h">Chart</h2><div id="rail-charts"></div></section>
  </aside>

  <main class="main">
    <div class="pickers">
      <button class="picker" id="pick-model" aria-haspopup="dialog"><div style="min-width:0"><small>Model</small><span id="pick-model-t"></span></div>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
      <button class="picker" id="pick-chart" aria-haspopup="dialog"><div style="min-width:0"><small id="pick-chart-l">Chart</small><span id="pick-chart-t"></span></div>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
    </div>

    <div class="head">
      <h1 id="title"></h1>
      <div class="tools">
        <select class="tool" id="run" aria-label="Model run"></select>
        <a class="tool" id="png" target="_blank" rel="noopener">PNG</a>
        <a class="tool" id="mp4" target="_blank" rel="noopener" download>MP4</a>
        <a class="tool" id="gif" target="_blank" rel="noopener">GIF</a>
      </div>
    </div>

    <div class="stage" id="stage">
      <img id="img" alt="">
      <video id="vid" controls playsinline preload="metadata" hidden></video>
      <div class="msg" id="msg" hidden></div>
    </div>

    <div class="dock" id="dock">
      <div class="btns">
        <button id="prev" aria-label="Back one step"><svg viewBox="0 0 18 18"><path d="M11.5 3.5L6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button id="play" class="play" aria-label="Play"><svg viewBox="0 0 18 18" id="play-i"><path d="M5 3.5v11l9-5.5z" fill="currentColor"/></svg></button>
        <button id="next" aria-label="Forward one step"><svg viewBox="0 0 18 18"><path d="M6.5 3.5L12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
      <div class="tape" id="tape">
        <div class="days" id="days"></div>
        <div class="ticks" id="ticks"></div>
        <div class="rule"></div><div class="done" id="done"></div>
        <input type="range" id="slider" min="0" max="0" value="0" aria-label="Forecast time">
      </div>
      <div class="when" id="when"></div>
    </div>

    <p class="note" id="note"></p>
    <section class="extra" id="extra" hidden><h3 id="extra-h"></h3><div class="row" id="extra-row"></div></section>
  </main>
</div>

<div class="sheet-bg" id="sheet-bg" hidden></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-h" hidden>
  <div class="grab"></div><h2 id="sheet-h"></h2><div id="sheet-body"></div>
</div>

<script>
const GROUPS = [
  ["Rain", ["precip6", "precip_total"]],
  ["Wind and gust", ["wind10", "gust10", "gust_max"]],
  ["Upper air", ["wind850", "vort850", "rh_mid", "z500_anom"]],
  ["Videos", ["v:globe_rain", "v:globe_storm_bay", "v:storm_bay", "v:storm_arab"]],
];
const SHORT = { precip6: "6-hour rain", precip_total: "Total rain", wind10: "10 m wind", gust10: "Gust",
  gust1h: "Gust every hour", gust_max: "Highest gust so far", wind850: "850 hPa wind", vort850: "850 hPa vorticity",
  rh_mid: "Mid-level humidity", z500_anom: "500 hPa anomaly", features_7day: "Weather features",
  features_rh_7day: "Humidity features", "v:globe_rain": "Globe: rain", "v:globe_wind": "Globe: wind",
  "v:globe_storm_bay": "Follow the storm, Bay", "v:globe_storm_arab": "Follow the storm, Arabian Sea",
  "v:storm_anim": "Storm loop, whole area", "v:storm_bay": "Storm loop, Bay", "v:storm_arab": "Storm loop, Arabian Sea" };
const ENS_GROUPS = [
  ["Tracks by pressure", ["tracks_all", "tracks_bob", "tracks_arab"]],
  ["Tracks by wind", ["tracks_wind_all", "tracks_wind_bob", "tracks_wind_arab"]],
  ["Pictures", ["p:tc_wind_png", "p:tc_wind_gif", "p:tc_centres_gif"]],
];
const ENS_SHORT = { all: "Whole map", bob: "Bay of Bengal", arab: "Arabian Sea", "p:tc_wind_png": "Wind classes and table",
  "p:tc_wind_gif": "Members, animated", "p:tc_centres_gif": "Mean pressure and spread" };
const NAMES = { ECMWF9: "ECMWF 9km", ECMWF: "ECMWF HRES", AIFS: "ECMWF AIFS", GFS: "NCEP GFS", AIGFS: "NOAA AIGFS", ICON: "DWD ICON",
  GEM: "CMC GEM", ECMWF_ENS: "ECMWF ENS", AIFS_ENS: "ECMWF AIFS ENS", GEFS: "NCEP GEFS", AIGEFS: "NOAA AIGEFS" };
const $ = (id) => document.getElementById(id);
let INDEX = null, timer = null, lastFocus = null;
let S = { mode: "models", model: null, run: null, chart: "precip6", i: 0, emodel: null, erun: null, eitem: "tracks_all" };

const runDate = (r) => new Date(Date.UTC(+r.slice(0, 4), +r.slice(4, 6) - 1, +r.slice(6, 8), +r.slice(8, 10)));
const fmtRun = (r) => runDate(r).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }) + " " + r.slice(8, 10) + "Z";
const ago = (iso) => { const h = (Date.now() - Date.parse(iso)) / 36e5;
  return h < 1 ? Math.max(1, Math.round(h * 60)) + " min ago" : h < 48 ? Math.round(h) + " h ago" : Math.round(h / 24) + " days ago"; };
const istDate = (initIso, h) => new Date(Date.parse(initIso) + h * 36e5);
const fmtIst = (d, o) => d.toLocaleString("en-GB", Object.assign({ timeZone: "Asia/Kolkata" }, o));
const age = (init) => { const a = (Date.now() - Date.parse(init)) / 36e5; return a > 30 ? "old" : a > 18 ? "warn" : ""; };

function cur() { const m = INDEX.models.find((x) => x.model === S.model); return { m, r: m && (m.runs.find((x) => x.run === S.run) || m.runs[0]) }; }
function vids() { const list = INDEX.videos[S.model] || []; return list.find((x) => x.run === cur().r.run) || list[0] || null; }
function ecur() { const m = INDEX.ens.find((x) => x.model === S.emodel); return { m, r: m && (m.runs.find((x) => x.run === S.erun) || m.runs[0]) }; }
function hours() { if (S.mode !== "models" || S.chart.startsWith("v:")) return []; const c = cur().r.charts[S.chart]; return c && c.hours ? c.hours : []; }
function url(file) { return `${S.model}/${cur().r.run}/${S.chart}/${file}`; }
function chartOk(c) { return c.startsWith("v:") ? !!(vids() && vids().items[c.slice(2)]) : !!cur().r.charts[c]; }
function ensOk(k) { const r = ecur().r; return k.startsWith("p:") ? !!(r.pictures && r.pictures[k.slice(2)]) : !!r.items[k]; }
function label(k) { return S.mode === "ens" ? (ENS_SHORT[k] || ENS_SHORT[k.split("_").pop()]) : (SHORT[k] || k); }
function ensGroupOf(k) { return (ENS_GROUPS.find(([, l]) => l.includes(k)) || [""])[0]; }

/* ---------- pickers: rail (desktop) and sheets (phone) ---------- */
function modelEntries() {
  return S.mode === "ens"
    ? INDEX.ens.map((m) => ({ key: m.model, run: m.runs[0], on: m.model === S.emodel,
        pick: () => { S.emodel = m.model; S.erun = m.runs[0].run; } }))
    : INDEX.models.map((m) => ({ key: m.model, run: m.runs[0], on: m.model === S.model,
        pick: () => { S.model = m.model; S.run = m.runs[0].run; } }));
}
function chartGroups() {
  return (S.mode === "ens" ? ENS_GROUPS : GROUPS).map(([g, list]) => [g, list.map((k) => ({
    key: k, ok: S.mode === "ens" ? ensOk(k) : chartOk(k), on: k === (S.mode === "ens" ? S.eitem : S.chart),
    pick: () => { if (S.mode === "ens") S.eitem = k; else S.chart = k; } }))]);
}
/* "Next run" line: the next cycle and roughly when it is complete here, from how long this model's last full run took */
const CYCLE_H = { GEM: 12, ECMWF9: 12 };
function nextRun(key) {
  const m = INDEX.models.find(x => x.model === key); if (!m || !m.runs.length) return null;
  const full = m.runs.find(r => !r.partial && r.made);
  const delay = full ? (Date.parse(full.made) - Date.parse(full.init)) : null; if (!delay || delay < 0 || delay > 20 * 3600e3) return null;
  const step = (CYCLE_H[key] || 6) * 3600e3, t0 = Date.parse(m.runs[0].init);
  const next = t0 + step, due = next + delay;
  const hh = new Date(next).toISOString().slice(11, 13) + "Z";
  if (m.runs[0].partial) return `${fmtRun(m.runs[0].run)} coming in · full ~${istTime(Date.parse(m.runs[0].init) + delay)}`;
  return Date.now() > due + 30 * 60e3 ? `Next: ${hh} run, due now` : `Next: ${hh} run ~${istTime(due)}`;
}
function istTime(ms) { return new Date(ms).toLocaleString("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" }) + " IST"; }
function drawRail() {
  const rm = $("rail-models"); rm.innerHTML = "";
  for (const e of modelEntries()) {
    const b = document.createElement("button"); b.className = "item"; b.setAttribute("aria-pressed", e.on);
    b.innerHTML = `<span class="dot ${age(e.run.init)}"></span><span class="name">${NAMES[e.key] || e.key}</span>` +
      `<span class="meta">${fmtRun(e.run.run)}${e.run.partial ? ` <span class="live" title="still coming in">to +${e.run.upto}h</span>` : ""}</span>`;
    b.title = `Run ${fmtRun(e.run.run)}, made ${ago(e.run.made)}`;
    const nx = S.mode === "ens" ? null : nextRun(e.key);
    if (nx) b.insertAdjacentHTML("beforeend", `<span class="next">${nx}</span>`);
    b.onclick = () => { e.pick(); render(true); }; rm.appendChild(b);
  }
  const rc = $("rail-charts"); rc.innerHTML = "";
  $("rail-charts-h").textContent = S.mode === "ens" ? "Product" : "Chart";
  for (const [g, items] of chartGroups()) {
    const sec = document.createElement("div"); sec.className = "group";
    sec.innerHTML = `<div class="group-name">${g}</div>`;
    const l = document.createElement("div"); l.className = "list";
    for (const it of items) {
      const b = document.createElement("button"); b.className = "item"; b.disabled = !it.ok;
      b.setAttribute("aria-pressed", it.on); b.innerHTML = `<span class="name">${label(it.key)}</span>`;
      b.onclick = () => { it.pick(); render(true); }; l.appendChild(b);
    }
    sec.appendChild(l); rc.appendChild(sec);
  }
  const more = document.createElement("div"); more.className = "group";            // pages that used to have their own tab
  more.innerHTML = S.mode === "ens"
    ? `<div class="group-name">More on cyclones</div><div class="list"><a class="item" href="lab.html#guide"><span class="name">Cyclone guidance (IMD / JTWC tracks)</span></a></div>`
    : `<div class="group-name">States</div><div class="list"><a class="item" href="lab.html#state"><span class="name">State maps</span></a></div>`;
  rc.appendChild(more);
}
function drawPickers() {
  const m = modelEntries().find((e) => e.on);
  $("pick-model-t").textContent = m ? (NAMES[m.key] || m.key) : "";
  const k = S.mode === "ens" ? S.eitem : S.chart;
  $("pick-chart-l").textContent = S.mode === "ens" ? ensGroupOf(k) || "Product" : "Chart";
  $("pick-chart-t").textContent = label(k);
}
function openSheet(kind) {
  lastFocus = document.activeElement;
  const body = $("sheet-body"); body.innerHTML = "";
  const tile = (txt, sub, on, ok, fn) => { const b = document.createElement("button"); b.className = "tile";
    b.setAttribute("aria-pressed", on); b.disabled = !ok; b.innerHTML = txt + (sub ? `<small>${sub}</small>` : "");
    b.onclick = () => { fn(); closeSheet(); render(true); }; return b; };
  if (kind === "model") {
    $("sheet-h").textContent = S.mode === "ens" ? "Ensemble" : "Model";
    const t = document.createElement("div"); t.className = "tiles";
    for (const e of modelEntries()) t.appendChild(tile(NAMES[e.key] || e.key, `Run ${fmtRun(e.run.run)}, ${ago(e.run.made)}`, e.on, true, e.pick));
    body.appendChild(t);
  } else {
    $("sheet-h").textContent = S.mode === "ens" ? "Product" : "Chart";
    for (const [g, items] of chartGroups()) {
      const h = document.createElement("div"); h.className = "group-name"; h.textContent = g; body.appendChild(h);
      const t = document.createElement("div"); t.className = "tiles";
      for (const it of items) t.appendChild(tile(label(it.key), "", it.on, it.ok, it.pick));
      body.appendChild(t);
    }
  }
  $("sheet-bg").hidden = $("sheet").hidden = false;
  const on = body.querySelector('[aria-pressed="true"]') || body.querySelector("button"); if (on) on.focus();
}
function closeSheet() { $("sheet-bg").hidden = $("sheet").hidden = true; if (lastFocus) lastFocus.focus(); }

/* ---------- stage ---------- */
function media(kind) {
  $("img").hidden = kind !== "img"; $("vid").hidden = kind !== "vid"; $("msg").hidden = kind !== "msg";
  if (kind !== "vid") { $("vid").pause(); $("vid").removeAttribute("src"); $("vid").load(); }
}
function links(png, mp4, gif) { for (const [id, h] of [["png", png], ["mp4", mp4], ["gif", gif]]) { $(id).hidden = !h; if (h) $(id).href = h; } }
function setTitle(main, sub) { $("title").innerHTML = ""; $("title").append(main || "");
  if (sub) { const s = document.createElement("small"); s.textContent = sub; $("title").append(s); } }
function playVideo(src, poster) { if ($("vid").getAttribute("src") !== src) { $("vid").poster = poster || ""; $("vid").src = src; } media("vid"); }
function message(t) { $("msg").textContent = t; media("msg"); links(null, null, null); }
function extra(title, figs) {
  $("extra").hidden = !figs.length; if (!figs.length) return;
  $("extra-h").textContent = title; const row = $("extra-row"); row.innerHTML = "";
  for (const [src, cap] of figs) { const f = document.createElement("figure");
    f.innerHTML = `<a href="${src}" target="_blank" rel="noopener"><img loading="lazy" src="${src}" alt="${cap}"></a><figcaption>${cap}</figcaption>`;
    row.appendChild(f); }
}
function runSelect(runs, sel) {
  const s = $("run"); s.innerHTML = "";
  for (const x of runs) { const o = document.createElement("option"); o.value = x.run; o.textContent = "Run " + fmtRun(x.run);
    o.selected = x.run === sel; s.appendChild(o); }
}

function showEns() {
  const { m, r } = ecur(); const base = `ens/${m.model}/${r.run}/`;
  $("dock").hidden = true; extra("", []); runSelect(m.runs, r.run);
  const name = NAMES[m.model] || m.model;
  if (S.eitem.startsWith("p:")) {
    const p = (r.pictures || {})[S.eitem.slice(2)];
    setTitle(ENS_SHORT[S.eitem], `${name}, run ${fmtRun(r.run)}`);
    if (!p) message("This picture was not made for this run.");
    else { $("img").src = base + p.file; $("img").alt = ENS_SHORT[S.eitem]; media("img");
      links(p.file.endsWith(".png") ? base + p.file : null, null, p.file.endsWith(".gif") ? base + p.file : null); }
  } else {
    const it = r.items[S.eitem];
    setTitle(`${ensGroupOf(S.eitem)}: ${ENS_SHORT[S.eitem.split("_").pop()]}`, `${name}, run ${fmtRun(r.run)}`);
    if (!it) message(Object.keys(r.items).length ? "No member has a cyclone system in this area in this run."
      : `No member of the ${fmtRun(r.run)} run has a cyclone system over the north Indian Ocean.`);
    else { playVideo(base + it.mp4, base + it.poster); links(null, base + it.mp4, it.gif ? base + it.gif : null);
      if (it.summary) extra("Where members bring the system ashore", [[base + it.summary, "Landfall summary at the end of the forecast"]]); }
  }
  $("note").textContent = r.credit || "";
  location.replace("#" + ["ens", m.model, r.run, S.eitem].join("/"));
}

function drawTape(hs, init) {
  const days = $("days"), ticks = $("ticks"); days.innerHTML = ""; ticks.innerHTML = "";
  if (hs.length < 2) return;
  const span = hs[hs.length - 1] - hs[0], pos = (h) => ((h - hs[0]) / span) * 100;
  const gap = 56 / Math.max($("tape").clientWidth, 1) * 100;      // a day label needs about 56 px
  let lastDay = null, lastPct = -100;
  for (const h of hs) {
    const d = istDate(init, h), day = fmtIst(d, { day: "numeric" });
    const t = document.createElement("i"); t.style.left = pos(h) + "%";
    if (day !== lastDay) {
      t.className = "major";
      if (pos(h) - lastPct > gap && pos(h) < 100 - gap * 0.8) { const s = document.createElement("span"); s.style.left = pos(h) + "%";
        s.textContent = fmtIst(d, { weekday: "short", day: "numeric" }); days.appendChild(s); lastPct = pos(h); }
      lastDay = day;
    }
    if (hs.length <= 130 || t.className) ticks.appendChild(t);
  }
}
function show() {
  if (S.mode === "ens") return showEns();
  const { m, r } = cur(); runSelect(m.runs, r.run); extra("", []);
  const name = NAMES[S.model] || S.model;
  if (S.chart.startsWith("v:")) {
    const v = vids(), it = v && v.items[S.chart.slice(2)];
    $("dock").hidden = true;
    setTitle(it ? it.title : SHORT[S.chart], `${name}, run ${fmtRun(v ? v.run : r.run)}`);
    if (!it) message(S.chart.includes("storm") ? "No system to follow in this area in this run." : "This video is still being made for this run.");
    else { const base = `vid/${S.model}/${v.run}/`; playVideo(base + it.mp4, base + it.poster); links(null, base + it.mp4, it.gif ? base + it.gif : null); }
    $("note").textContent = v && v.run !== r.run ? `This video is from the ${fmtRun(v.run)} run; the ${fmtRun(r.run)} video is still being made.` : "";
    location.replace("#" + [S.model, r.run, S.chart].join("/"));
    return;
  }
  const c = r.charts[S.chart];
  setTitle(c ? c.title : SHORT[S.chart], `${name}, run ${fmtRun(r.run)}` + (r.partial ? ` · still coming in, out to +${r.upto} h` : ""));
  $("note").textContent = c && c.sheet ? c.note : "";
  if (!c) { $("dock").hidden = true; message("This chart is not made for this model."); return; }
  media("img");
  if (c.sheet) { $("dock").hidden = true; $("img").src = url("sheet.png"); $("img").alt = c.title; links(url("sheet.png"), null, null); return; }
  const hs = c.hours; S.i = Math.max(0, Math.min(S.i, hs.length - 1)); const h = hs[S.i];
  $("dock").hidden = false;
  const key = S.model + r.run + S.chart;
  if ($("slider").dataset.key !== key) { drawTape(hs, r.init); $("slider").dataset.key = key; }
  $("slider").max = hs.length - 1; $("slider").value = S.i;
  $("done").style.width = (hs.length > 1 ? (h - hs[0]) / (hs[hs.length - 1] - hs[0]) * 100 : 0) + "%";
  const f = "f" + String(h).padStart(3, "0") + ".png";
  $("img").src = url(f); $("img").alt = `${c.title}, ${h} hours ahead`; links(url(f), null, c.gif ? url("anim.gif") : null);
  const d = istDate(r.init, h);
  $("when").innerHTML = `+${h} h<small>${fmtIst(d, { weekday: "short", day: "numeric", month: "short" })}, ` +
    `${fmtIst(d, { hour: "2-digit", minute: "2-digit", hour12: false })} IST</small>`;
  for (const k of [1, 2, -1]) { const j = S.i + k; if (j >= 0 && j < hs.length) new Image().src = url("f" + String(hs[j]).padStart(3, "0") + ".png"); }
  location.replace("#" + [S.model, r.run, S.chart, h].join("/"));
}
function render(keepHour) {
  play(false);
  const old = keepHour ? hours()[S.i] : null;
  $("tab-models").setAttribute("aria-pressed", S.mode === "models"); $("tab-ens").setAttribute("aria-pressed", S.mode === "ens");
  $("tab-ens").hidden = !INDEX.ens.length;
  if (S.mode === "models" && !chartOk(S.chart)) S.chart = GROUPS.flatMap(([, l]) => l).find(chartOk) || S.chart;
  if (S.mode === "ens" && !ensOk(S.eitem)) S.eitem = ENS_GROUPS.flatMap(([, l]) => l).find(ensOk) || S.eitem;
  drawRail(); drawPickers();
  if (old != null) { const hs = hours(); const j = hs.indexOf(old); S.i = j >= 0 ? j : Math.min(S.i, Math.max(hs.length - 1, 0)); }
  show();
}
function step(k) { const n = hours().length; if (!n) return; S.i = (S.i + k + n) % n; show(); }
function play(on) {
  if (on === undefined) on = !timer;
  clearInterval(timer); timer = null;
  $("play-i").innerHTML = on ? '<path d="M5 3.5h3v11H5zM10 3.5h3v11h-3z" fill="currentColor"/>' : '<path d="M5 3.5v11l9-5.5z" fill="currentColor"/>';
  $("play").setAttribute("aria-label", on ? "Pause" : "Play");
  if (on) timer = setInterval(() => step(1), hours().length > 80 ? 300 : 650);
}
$("prev").onclick = () => { play(false); step(-1); };
$("next").onclick = () => { play(false); step(1); };
$("play").onclick = () => play();
$("slider").oninput = (e) => { play(false); S.i = +e.target.value; show(); };
$("run").onchange = (e) => { if (S.mode === "ens") S.erun = e.target.value; else S.run = e.target.value; render(true); };
$("tab-models").onclick = () => { S.mode = "models"; render(); };
$("tab-ens").onclick = () => { S.mode = "ens"; if (!S.emodel) { S.emodel = INDEX.ens[0].model; S.erun = INDEX.ens[0].runs[0].run; } render(); };
$("pick-model").onclick = () => openSheet("model");
$("pick-chart").onclick = () => openSheet("chart");
$("sheet-bg").onclick = closeSheet;
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && !$("sheet").hidden) { closeSheet(); return; }
  if (!$("sheet").hidden || ["SELECT", "VIDEO", "INPUT"].includes(e.target.tagName) || $("dock").hidden) return;
  if (e.key === "ArrowLeft") { play(false); step(-1); e.preventDefault(); }
  if (e.key === "ArrowRight") { play(false); step(1); e.preventDefault(); }
  if (e.key === " ") { play(); e.preventDefault(); }
});
addEventListener("resize", () => { $("slider").dataset.key = ""; if (INDEX && !$("dock").hidden) show(); });
let tx = null;                                       // swipe the chart left / right to step through time
$("stage").addEventListener("touchstart", (e) => { tx = e.touches[0].clientX; }, { passive: true });
$("stage").addEventListener("touchend", (e) => {
  if (tx == null || $("dock").hidden) return;
  const dx = e.changedTouches[0].clientX - tx; tx = null;
  if (Math.abs(dx) > 50) { play(false); step(dx < 0 ? 1 : -1); }
});

fetch("index.json", { cache: "no-store" }).then((r) => r.json()).then((ix) => {
  INDEX = ix; INDEX.ens = ix.ens || []; INDEX.videos = ix.videos || {};
  if (!ix.models.length) { $("built").textContent = "The first charts are on their way."; return; }
  $("built").textContent = "Updated " + ago(ix.built);
  const parts = decodeURIComponent(location.hash.slice(1)).split("/");
  if (INDEX.ens.length) { S.emodel = INDEX.ens[0].model; S.erun = INDEX.ens[0].runs[0].run; }
  if (parts[0] === "ens" && INDEX.ens.length) {
    const em = INDEX.ens.find((x) => x.model === parts[1]) || INDEX.ens[0];
    S.mode = "ens"; S.emodel = em.model; S.erun = (em.runs.find((x) => x.run === parts[2]) || em.runs[0]).run;
    if (parts[3]) S.eitem = parts[3];
  }
  const [m, run, chart, h] = S.mode === "ens" ? [] : parts;
  const mm = ix.models.find((x) => x.model === m) || ix.models[0];
  S.model = mm.model; S.run = (mm.runs.find((x) => x.run === run) || mm.runs[0]).run;
  if (chart) S.chart = chart;
  render(false);
  if (h) { const j = hours().indexOf(+h); if (j >= 0) { S.i = j; show(); } }
}).catch((e) => { $("built").textContent = "The chart list did not load. Reload the page to try again."; console.error(e); });
</script>
<script>
(() => {
  const b = document.getElementById("theme"), root = document.documentElement;
  const dark = () => (root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")) === "dark";
  const icon = () => { b.innerHTML = dark()
    ? '<svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="4" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6L16 16M4 16l1.4-1.4M14.6 5.4L16 4"/></g></svg>'
    : '<svg viewBox="0 0 20 20"><path d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1z" fill="currentColor"/></svg>';
    b.title = dark() ? "Switch to light" : "Switch to dark"; };
  b.onclick = () => { const t = dark() ? "light" : "dark"; root.dataset.theme = t;
    try { localStorage.setItem("theme", t); } catch (e) {} icon(); };
  icon();
})();
</script>
</body>
</html>
